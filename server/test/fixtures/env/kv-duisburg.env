# ADFC KV Duisburg — production .env
# Translated from config.ini 2026-10-24; passes the startup guard (no warnings).
# Changes vs. the ini: C128 → CODE128; booleans ja → true, nein → false.
# UMSATZSTEUER_PROZENT=0 present but unused (VAT off).

# ── Instance ────────────────────────────────────────────────────────────────
KREIS_VERBAND=KV Duisburg
LOGO_TEXT=Duisburg
KV_WEB_URL=https://duisburg.adfc.de
SERVER_BASIS_URL=https://codierformular.adfc-duisburg.de
ORT_INITIAL=Duisburg
DATENSCHUTZ_URL=https://duisburg.adfc.de/datenschutz

ZEIGE_AKKU=true

ZEIGE_EMAIL=true
EMAIL_ADRESSE=codierung@adfc-duisburg.de
ZEIGE_TELEFON=true
TELEFON_NUMMER=0203 774211

PREISE_ANZEIGEN=true
PREIS_NICHT_MITGLIED=20
PREIS_MITGLIED=5
PREIS_ANHAENGER_NICHT_MITGLIED=20
PREIS_ANHAENGER_MITGLIED=5
AUFPREIS_AKKU_NICHT_MITGLIED=5
AUFPREIS_AKKU_MITGLIED=2,5
ZEIGE_UMSATZSTEUER=false
UMSATZSTEUER_PROZENT=0

ZEIGE_BARZAHLUNG=true
ZEIGE_KARTENZAHLUNG=false
PDF_NUR_EINE_SEITE=false

ZEIGE_CODIERUNG_BUCHEN=true
CODIERUNG_BUCHEN_URL=https://adfc-duisburg.de/codiertermin
ZEIGE_CODIERUNG_INFO=true
CODIERUNG_INFO_URL=https://adfc-duisburg.de/codierung

BARCODE_TYP=CODE128
UMLAUTE_IM_BARCODE=false
INKLUSIVE_JAHR=true

# ── Infra ───────────────────────────────────────────────────────────────────
PORT=8080
TZ=Europe/Berlin
UPSTREAM_URLS=https://fa-technik-adfc.de/fein,https://codierung.adfc-hessen.de/code/ein
CACHE_ENABLED=true
CACHE_DB_PATH=/data/codierauftrag-cache.sqlite
CACHE_MAX_AGE_DAYS=90
CACHE_TYPO_DAYS=90
CACHE_PURGE_MAX_AGE_DAYS=365
CACHE_PURGE_INTERVAL_HOURS=720
RATE_LIMIT_PER_MINUTE=20
