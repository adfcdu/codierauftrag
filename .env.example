# ADFC-Codierformular — .env-Vorlage (alle Schlüssel, generische Instanz)
# Zu .env umbenennen; jeder Schlüssel wird beim Start validiert (fail-fast, Fehler auf Deutsch; Warnungen sind nicht-fatal).
# true/false sind die einzigen akzeptierten Booleschen Literale (exakt kleingeschrieben)

# Instanz
KREIS_VERBAND=KV Beispielstadt                  # Pflicht; Buchstaben inkl. Umlaute + ß, -, /, Leerzeichen
LOGO_TEXT=Dorf an der Beispiel-Stadt            # Pflicht; dieselbe Namensregel
KV_WEB_URL=https://beispielstadt.adfc.de        # Pflicht, http/https
SERVER_BASIS_URL=                               # optional; URL ohne Pfad; leer = Client nutzt location.origin
ORT_INITIAL=Beispielstadt                       # optional; füllt das Feld Ort vorab aus
DATENSCHUTZ_URL=https://beispielstadt.adfc.de/datenschutz
                                                # Standard: lokale Seite; sonst http/https URL; steuert den Datenschutz-Link im Formularfuß

ZEIGE_AKKU=true                                 # Akku-Feld / Aufpreis / PDF-Text
ZEIGE_CARBONRAHMEN=true                         # Carbon-Rahmen-Feld / Carbon-Preisberechnung / PDF-Zeile

ZEIGE_EMAIL=false                               # true erfordert EMAIL_ADRESSE
EMAIL_ADRESSE=mailto:codierung@beispielstadt.example
                                                # E-Mail-Adresse im Formularfuß, optional mit mailto:-Präfix (z. B. mailto:codierung@beispielstadt.example); nur relevant bei ZEIGE_EMAIL=true
ZEIGE_TELEFON=false                             # true erfordert TELEFON_NUMMER
TELEFON_NUMMER=tel:0123 456789                  # Telefonnummer des KV, optional mit tel:-Präfix (z. B. tel:0123 456789); nur relevant bei ZEIGE_TELEFON=true

PREISE_ANZEIGEN=true                            # true erfordert ALLE SECHS Preise unten
PREIS_MITGLIED=5                                # Preis Leihrad, Mitglied (Format mit Dezimalpunkt, z. B. 12.50)
PREIS_NICHT_MITGLIED=20                         # Preis Leihrad, Nicht-Mitglied
PREIS_ANHAENGER_MITGLIED=5                      # Preis Leihanhänger, Mitglied
PREIS_ANHAENGER_NICHT_MITGLIED=20               # Preis Leihanhänger, Nicht-Mitglied
AUFPREIS_AKKU_MITGLIED=2,5                      # Akku-Aufpreis, Mitglied; nur relevant bei ZEIGE_AKKU=true
AUFPREIS_AKKU_NICHT_MITGLIED=5                  # Akku-Aufpreis, Nicht-Mitglied; nur relevant bei ZEIGE_AKKU=true
ZEIGE_UMSATZSTEUER=false                        # 'true' mit PREISE_ANZEIGEN=false: USt wird stillschweigend ignoriert
UMSATZSTEUER_PROZENT=0                          # Pflicht genau dann, wenn ZEIGE_UMSATZSTEUER=true (und Preise an); 0–100

ZEIGE_BARZAHLUNG=false                          # Barzahlungs-Kästchen im PDF
ZEIGE_KARTENZAHLUNG=false                       # Kartenzahlungs-Kästchen im PDF
PDF_NUR_EINE_SEITE=false                        # true = ein Blatt; false = zwei Ausfertigungen

ZEIGE_CODIERUNG_BUCHEN=false                    # true erfordert CODIERUNG_BUCHEN_URL (Link „Zur Buchung“)
CODIERUNG_BUCHEN_URL=                           # Ziel des Buchungs-Links (http/https)
ZEIGE_CODIERUNG_INFO=false                      # true erfordert CODIERUNG_INFO_URL
CODIERUNG_INFO_URL=                             # Ziel des Info-Links (http/https)

BANNER_1_TEXT=Aktuell: Angebotsstart für die Saison 2026 — bitte vorab online einen Termin buchen.
                                                # Hinweis-Banner 1; leer = ausgeblendet; max. 300 Zeichen
BANNER_1_URL=https://beispielstadt.adfc.de      
                                                # optional; Link-Ziel für Banner 1 (nur https) — der Banner-Text wird zum Link; wirkungslos ohne BANNER_1_TEXT
BANNER_2_TEXT=Hinweis: Zurzeit keine E-Bike-Codierung möglich (Ersatzteil-Engpass).
                                                # Hinweis-Banner 2 unter Banner 1; leer = ausgeblendet; max. 300 Zeichen
BANNER_2_URL=                                   
                                                # optional; Link-Ziel für Banner 2 (nur https) — der Banner-Text wird zum Link; wirkungslos ohne BANNER_2_TEXT

BARCODE_TYP=CODE128                             # CODE128 | CODE39 | CODE39EXT (Legacy-Aliase: C128, C39E)
UMLAUTE_IM_BARCODE=false                        # false empfohlen (die meisten Hardware-Scanner scheitern an FNC4)
INKLUSIVE_JAHR=true                             # zweistellige Jahreszahl in der EIN — standardmäßig AN

# Infrastruktur
PORT=8080                                       # Container lauscht auf plain HTTP (TLS endet am reverse-proxy)
TZ=Europe/Berlin                                # IANA-Zeitzone für EIN-Jahreszahl + PDF-Zeitstempel (01)
                                                # über .env oder compose environment setzen — nie die Browser-Zone
UPSTREAM_URLS=https://fa-technik-adfc.de/fein,https://codierung.adfc-hessen.de/code/ein
                                                # Komma-Liste, der Erste ist primär
CACHE_ENABLED=true                              # false umgeht den Cache (Tests/Probeläufe)
CACHE_DB_PATH=/data/codierauftrag-cache.sqlite  # Docker-Volume (Pflicht!)
CACHE_MAX_AGE_DAYS=90                           # Nur Fenster für Frische/Revalidierung — NIE ein Purge-Alter
CACHE_TYPO_DAYS=90                              # Purge-Alter für Variant-Zeilen (Tippfehler)
CACHE_PURGE_MAX_AGE_DAYS=365                    # Purge-Alter für kanonische + Listen-Zeilen; muss größer sein als CACHE_MAX_AGE_DAYS
CACHE_PURGE_INTERVAL_HOURS=720                  # Takt des Purge-Timers (Standard ~monatlich); Purge läuft zusätzlich beim Start
BREAKER_FAILURE_THRESHOLD=5                     # aufeinanderfolgende Upstream-Fehler, bevor der Circuit Breaker öffnet;
                                                # solange offen, gehen Lookups direkt zum veralteten Fallback / 502
BREAKER_COOLDOWN_MS=60000                       # Abkühlfenster in ms, bevor der Upstream erneut versucht wird
RATE_LIMIT_PER_MINUTE=10                        # In-Memory-Fixed-Window pro IP; 0 = aus
