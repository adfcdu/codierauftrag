{
  "name": "codierauftrag",
  "version": "1.0.0",
  "private": true,
  "description": "ADFC Codierformular (KV Duisburg) — Straßen-Code-Lookup mit Cache + clientseitigem Formular und PDF-Erzeugung",
  "type": "module",
  "engines": {
    "node": ">=26.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-bundle.mjs",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@bwip-js/browser": "^4.11.4",
    "@fastify/static": "^10.1.7",
    "@sinclair/typebox": "^0.34.52",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
